  if (any(tbs$tbs_prim_T > 100)) paste0(liste(tbs$nom[tbs$tbs_prim_T > 100]),
    " dépasse(nt) 100 %, signe probable d'élèves hors âge ou déplacés accueillis. ") else "", sep = "")
if (nrow(tpp) > 1) cat(
  "Au post-primaire, l'écart est encore plus marqué : de ", fmt(tpp$tbs_pp_T[1], 1), " % (", tpp$nom[1],
  ") à ", fmt(tail(tpp$tbs_pp_T, 1), 1), " % (", tail(tpp$nom, 1), "). ", sep = "")
