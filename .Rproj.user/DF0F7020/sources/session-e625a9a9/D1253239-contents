# --- Utilitaires de mise en forme et d'interprétation
fmt <- function(x, d = 2) ifelse(is.na(x), "n.d.",
                                 formatC(x, format = "f", digits = d, big.mark = " ", decimal.mark = ","))
pct <- function(x, d = 0) paste0(fmt(100 * x, d), " %")
liste <- function(x) {
  x <- unique(na.omit(as.character(x)))
  if (length(x) == 0) return("aucune")
  if (length(x) == 1) return(x)
  paste(paste(head(x, -1), collapse = ", "), "et", tail(x, 1))
}
sens_ips <- function(x) case_when(is.na(x) ~ "non disponible",
                                  x < 0.97 ~ "en défaveur des filles",
                                  x > 1.03 ~ "en défaveur des garçons",
                                  TRUE ~ "à parité")
fig <- function(nom) {
  f <- chemin_fig(nom)
  if (file.exists(f)) knitr::include_graphics(normalizePath(f))
  else knitr::asis_output(paste0("\n*Figure « ", nom, " » non disponible : relancer le script d'analyse.*\n"))
}
tab <- function(d, ...) knitr::kable(d, format.args = list(decimal.mark = ",", big.mark = " "), ...)

