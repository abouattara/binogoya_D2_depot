      "augmente dans **", nrow(tend_plus), " région(s)** et diminue dans ", nrow(tend_moins), ". ", sep = "")
  if (nrow(tend_plus) > 0) cat("Les écarts se creusent le plus vite dans ", liste(head(tend_plus$nom, 3)),
                               " (+", fmt(tend_plus$pente_imde[1], 3), " point d'indice par an pour ", tend_plus$nom[1], "). ", sep = "")
  if (nrow(tend_moins) > 0) cat("Ils se réduisent le plus dans ", liste(head(arrange(tend_moins, pente_imde)$nom, 3)), ". ", sep = "")
  ins <- intersect(head(tend_plus$nom, 5), top3$nom)
  if (length(ins) > 0) cat("\n\n**Point d'alerte** : ", liste(ins),
                           " cumule(nt) un niveau d'inégalité parmi les plus élevés et une dégradation récente.\n", sep = "")
}
