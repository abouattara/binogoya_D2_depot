```

```{r interp-genre, results = "asis"}
for (i in seq_len(nrow(gen))) {
  g <- gen[i, ]
  if (g$n_obs == 0) next
  cat("- **", sub("^(.)", "\\U\\1", g$niveau, perl = TRUE), "** : ",
      if (length(g$filles[[1]]) > 0) paste0(length(g$filles[[1]]), " région(s) en défaveur des filles (",
                                             liste(g$filles[[1]]), ")") else "aucune région en défaveur des filles",
      if (length(g$garcons[[1]]) > 0) paste0(" ; ", length(g$garcons[[1]]), " en défaveur des garçons (",
                                              liste(g$garcons[[1]]), ")") else "",
      ". Écart le plus marqué pour les filles : ", g$min_nom, " (IPS ", fmt(g$min_val), ").\n", sep = "")
}
```

```{r interp-genre2, results = "asis"}
n_f <- map_int(gen$filles, length); names(n_f) <- gen$niveau
if (sum(gen$n_obs > 0) >= 2) {
  premier <- gen$niveau[gen$n_obs > 0][1]; dernier <- tail(gen$niveau[gen$n_obs > 0], 1)
  cat("\nLecture : le nombre de régions où les filles sont désavantagées passe de ", n_f[premier], " au ",
      premier, " à ", n_f[dernier], " au ", dernier, ". ",
      if (n_f[dernier] > n_f[premier])
        "Les écarts de genre se forment surtout après le primaire, au moment de la transition et du maintien des filles dans le système, ce qui oriente vers des mesures de maintien plutôt que d'accès."
      else if (n_f[dernier] < n_f[premier])
        "Les écarts de genre sont plus marqués à l'entrée du système : l'enjeu principal est l'accès des filles au primaire."
      else "Les écarts de genre sont de même ampleur à tous les niveaux.", "\n", sep = "")
}
```

## Écarts d'accès entre territoires

```{r interp-acces, results = "asis"}
if (nrow(tbs) > 1) cat(
  "En ", annee_ref, ", le TBS primaire va de **", fmt(tbs$tbs_prim_T[1], 1), " % (", tbs$nom[1], ")** à **",
  fmt(tail(tbs$tbs_prim_T, 1), 1), " % (", tail(tbs$nom, 1), ")**, soit un rapport de 1 à ",
